<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Sonet · Logo A "S líquida" · adaptive-icon BACKGROUND (opaco, 108×108).
         Ónix profundo con halo violeta (gradiente lineal + radial), como el SVG
         original. El reflejo elíptico superior del SVG (blanco al 5%) se omite:
         invisible a tamaño de launcher y sin equivalente limpio en VectorDrawable. -->
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"
        android:fillColor="#FF0A0A12">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#FF171233"
                    android:offset="0" />
                <item
                    android:color="#FF0B0A14"
                    android:offset="0.55" />
                <item
                    android:color="#FF0A0A12"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"
        android:fillColor="#00000000">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="77.76"
                android:centerY="19.44"
                android:gradientRadius="70.2"
                android:type="radial">
                <item
                    android:color="#8C7C3AED"
                    android:offset="0" />
                <item
                    android:color="#1FC026D3"
                    android:offset="0.55" />
                <item
                    android:color="#00C026D3"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
